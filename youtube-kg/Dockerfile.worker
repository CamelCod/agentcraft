# Multi-stage Dockerfile for Celery Workers

# Base image with dependencies
FROM python:3.12-slim as base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend .

# Production stage - Celery worker
FROM base as worker

# Create non-root user for security
RUN useradd -m celery

USER celery

# Run Celery worker with 4 concurrent processes
CMD ["celery", "-A", "app.workers.celery_app", "worker", \
     "--loglevel=info", \
     "--concurrency=4", \
     "-Q", "default,discovery,ingestion,extraction,verification,reporting"]
