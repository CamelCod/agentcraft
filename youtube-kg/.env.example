# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change-me-to-a-random-64-char-string
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=youtubekg
POSTGRES_USER=youtubekg
POSTGRES_PASSWORD=changeme

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO (S3-compatible object storage) ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_RAW=raw-audio
MINIO_BUCKET_TRANSCRIPTS=transcripts
MINIO_BUCKET_REPORTS=reports
MINIO_SECURE=false

# ─── YouTube Data API ─────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: anthropic | openai | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
# Model used for domain discovery and extraction
LLM_MODEL=claude-haiku-4-5-20251001
# Model used for report generation (higher quality)
LLM_REPORT_MODEL=claude-sonnet-4-6

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Options: sentence-transformers | openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ─── Whisper Service ─────────────────────────────────────────────────────────
WHISPER_SERVICE_URL=http://whisper:9002
# Options: tiny | base | small | medium | large-v3
WHISPER_MODEL=medium
# Supported languages: auto-detect or ISO 639-1 code (e.g. ar, en, fr)
WHISPER_DEFAULT_LANGUAGE=auto

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=4

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:3000,https://agentcraftconsultancy.com

# ─── JWT (legacy — unused when SUPABASE_JWT_SECRET is set) ───────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# 1. Create a free project at https://supabase.com
# 2. Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Project Settings > API > JWT Secret  (used by backend to verify tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# 1. Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (Docker)
# 2. Add Public Hostname: agentcraftconsultancy.com → http://nginx:80
# 3. Paste the token shown in the install command
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
